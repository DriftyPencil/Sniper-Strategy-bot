# IG API credentials. Start with DEMO and DRY_RUN=true.
IG_ENV=DEMO
IG_API_KEY=replace_me
IG_USERNAME=replace_me
IG_PASSWORD=replace_me
IG_ACCOUNT_ID=

# Comma-separated IG EPICs for forex spread betting markets.
# Verify the EPICs in your IG account before live trading.
MARKET_EPICS=CS.D.EURUSD.MINI.IP,CS.D.GBPUSD.MINI.IP

# Strategy/runtime settings.
DRY_RUN=true
POLL_SECONDS=60
RESOLUTION=MINUTE_5
PRICE_POINTS=120
USE_SPREAD_FILTER=false
MAX_SPREAD_POINTS=2.5
FAST_EMA=9
SLOW_EMA=21
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
MIN_BULL_SCORE_LONG=60
MIN_BEAR_SCORE_SHORT=0
REQUIRE_SHORT_BEAR_DOMINANCE=true
MIN_RISK_REWARD=1.0
STOP_ATR_MULTIPLE=1.5
TARGET_MULTIPLES=1,2,3,4,5
TAKE_PROFIT_ALLOCATIONS=0.5,0.25,0.25
BROKER_TARGET_INDEX=2

# Spread bet stake in GBP per point. Keep this demo-only while validating.
DEFAULT_SIZE=10
BACKTEST_STARTING_BALANCE=10000

# Local/public API server.
API_HOST=127.0.0.1
API_PORT=8000
# Set this before exposing mutation endpoints publicly.
API_ADMIN_TOKEN=

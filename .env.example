# IG API credentials. Start with DEMO and DRY_RUN=true.
IG_ENV=DEMO
IG_API_KEY=replace_me
IG_USERNAME=replace_me
IG_PASSWORD=replace_me
IG_ACCOUNT_ID=

# Comma-separated IG EPICs for forex spread betting markets.
# Verify the EPICs in your IG account before live trading.
MARKET_EPICS=CS.D.EURUSD.MINI.IP,CS.D.GBPUSD.MINI.IP

# Strategy/runtime settings.
DRY_RUN=true
POLL_SECONDS=60
RESOLUTION=MINUTE_5
PRICE_POINTS=120
MAX_SPREAD_POINTS=2.5
FAST_EMA=9
SLOW_EMA=21
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
SCORE_THRESHOLD=0
MIN_RISK_REWARD=1.0
STOP_ATR_MULTIPLE=1.5
TARGET_MULTIPLES=1,2,3,4,5
BROKER_TARGET_INDEX=2

# Spread bet size in GBP per point. Keep this tiny in demo while validating.
DEFAULT_SIZE=0.5
